{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store items available for purchase.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "isNew": { "type": "boolean" },
        "isBestseller": { "type": "boolean" },
        "isViral": { "type": "boolean" },
        "tags": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "images": {
          "type": "array",
          "items": { "type": "string" }
        },
        "variants": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["name", "brand", "price", "image", "category", "description"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categories.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "image": { "type": "string" },
        "parentId": { "type": "string" }
      },
      "required": ["name"]
    },
    "Admin": {
      "title": "Admin",
      "description": "List of administrators.",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" },
        "createdAt": { "type": "string" },
        "items": { "type": "array" },
        "shippingAddress": { "type": "object" },
        "userEmail": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "paymentMethod": { "type": "string" }
      },
      "required": ["userId", "status", "total", "createdAt", "items"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products available in the store."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories for the store."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Administrators who have write access."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "User checkout orders"
    }
  }
}
